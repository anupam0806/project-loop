# ==============================================================================
# PROJECT LOOP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# SAFE PLACEHOLDERS ONLY — NEVER COMMIT REAL SECRETS
# ==============================================================================

# Database Connection (Neon PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-character-random-secret-key"

# AI Provider Strategy
# Options:
#   - "free"   : Development default (Groq gpt-oss-20b for classification, Gemini 2.5 Flash for Ask LOOP & VoC)
#   - "claude" : Production tier (Claude Haiku for classification, Claude Sonnet for Ask LOOP & VoC)
#   - "mock"   : Automated test suites (Zero API calls, deterministic responses)
#   - "gemini" : Gemini-only mode
#   - "groq"   : Groq-only mode
AI_PROVIDER="free"

# AI Provider API Keys (Populate based on chosen AI_PROVIDER)
ANTHROPIC_API_KEY="sk-ant-api03-placeholder-key-for-claude"
GEMINI_API_KEY="AIzaSyPlaceholderKeyForGemini"
GROQ_API_KEY="gsk_placeholder_key_for_groq"
